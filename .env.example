# ============================================================
# bayrak.ai — Phase 1 Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# --- Database ---
# Neon Dashboard → Project → Connection Details (pooled connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Neon Dashboard → create a branch 'test' → Connection Details
# Used for DB integration tests; leave unset to skip DB tests
TEST_DATABASE_URL=postgres://user:password@host/dbname-test?sslmode=require

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_me_with_openssl_rand_base64_32

# Resend Dashboard → API Keys → Create API Key
AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Public URL of this app (http://localhost:3000 for dev)
AUTH_URL=http://localhost:3000

# Comma-separated list of office email addresses allowed to sign in
AUTH_ALLOWED_EMAILS=engineer@bayrak.ai,manager@client.com

# --- Telegram ---
# Telegram @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-example

# Generate locally: openssl rand -hex 32
# Must match the secret_token used in setWebhook call
TELEGRAM_WEBHOOK_SECRET=replace_me_with_openssl_rand_hex_32

# --- Tenant ---
# Fixed UUID for the single default tenant (v1 single-tenant MVP)
# This value is seeded in the first migration — do not change after first deploy
BAYRAK_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- Mapbox (dashboard map — Phase 5) ---
# account.mapbox.com → Tokens → default public token (scopes: styles:read, fonts:read)
# PUBLIC token, exposed to the browser via the NEXT_PUBLIC_ prefix — safe to ship in client JS.
# Before sharing any dashboard URL externally, restrict this token to https://bayrak.ai/*
# (and www) under Tokens → URL restrictions in the Mapbox dashboard (D-62 / SC4).
# On Vercel, also add it via the project's Environment Variables (or `vercel env add`).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxx

# --- AI (Phase 16 — AI Vision Assist) ---
# Vercel Dashboard → Project → Settings → AI Gateway, or provision via OIDC (no manual rotation).
# For local dev: paste the static API key here. For production: use `vercel env pull` via OIDC.
AI_GATEWAY_API_KEY=

# Random secret used to authenticate Vercel cron requests to /api/cron/ai-flags.
# Generate with: openssl rand -hex 32
# Set in Vercel project env AND .env.local. Vercel sends this automatically as Authorization: Bearer.
CRON_SECRET=
